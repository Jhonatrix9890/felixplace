---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDatabase } from '@netlify/database';

export const prerender = false;

Astro.response.headers.set(
  'Netlify-CDN-Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=300',
);

const db = getDatabase();

const posts = await db.sql`
  SELECT
    title,
    slug,
    category,
    image_url,
    image_alt,
    description,
    author_name
  FROM posts
  WHERE kind = 'news'
    AND status = 'published'
  ORDER BY published_at DESC NULLS LAST, created_at DESC
  LIMIT 12
`;
---

<BaseLayout
  title="Noticias de tecnología"
  description="Noticias de tecnología explicadas con claridad en FelixPlace."
>
  <main class="pagina">
    <header class="intro">
      <p class="etiqueta">FELIXPLACE · ACTUALIDAD</p>
      <h1>Noticias de tecnología</h1>
      <p>
        Entérate de las novedades y descubre qué significan para ti, con
        explicaciones claras y útiles.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="vacio">Todavía no hay noticias publicadas. Vuelve pronto.</p>
      ) : (
        <section class="cuadricula" aria-label="Noticias recientes">
          {posts.map((post) => (
            <article class="tarjeta">
              <a
                class="imagen-enlace"
                href={`/noticias/${post.slug}`}
                aria-label={`Leer noticia: ${post.title}`}
              >
                {post.image_url ? (
                  <img
                    src={post.image_url}
                    alt={post.image_alt || post.title}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="imagen-vacia" aria-hidden="true">
                    FELIXPLACE
                  </span>
                )}
              </a>

              <div class="contenido-tarjeta">
                <p class="categoria">{post.category || 'Tecnología'}</p>
                <h2>
                  <a href={`/noticias/${post.slug}`}>{post.title}</a>
                </h2>

                {post.description && (
                  <p class="resumen">{post.description}</p>
                )}

                <p class="autor">Por {post.author_name}</p>
              </div>
            </article>
          ))}
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .pagina {
    width: min(1100px, calc(100% - 40px));
    min-height: 60vh;
    margin: 0 auto;
    padding: 54px 0 20px;
  }

  .intro {
    max-width: 760px;
    margin-bottom: 32px;
  }

  .etiqueta {
    margin: 0 0 10px;
    color: #147c9b;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    color: #102247;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.1;
  }

  .intro > p:last-child {
    max-width: 680px;
    margin: 14px 0 0;
    color: #5b687b;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .cuadricula {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .tarjeta {
    overflow: hidden;
    border: 1px solid #e2e8f1;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 8px 24px rgb(15 35 65 / 6%);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .tarjeta:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgb(15 35 65 / 11%);
  }

  .imagen-enlace {
    display: block;
    overflow: hidden;
    background: #e8eff7;
  }

  .imagen-enlace img,
  .imagen-vacia {
    display: grid;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .imagen-vacia {
    place-items: center;
    background: linear-gradient(135deg, #102d62, #087d9f);
    color: #b5f4ff;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .contenido-tarjeta {
    padding: 18px;
  }

  .categoria {
    margin: 0 0 8px;
    color: #147c9b;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0;
    color: #102247;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    color: #087d9f;
  }

  .resumen {
    margin: 10px 0 0;
    color: #5b687b;
    line-height: 1.65;
  }

  .autor {
    margin: 14px 0 0;
    color: #748095;
    font-size: 0.9rem;
  }

  .vacio {
    padding: 22px;
    border: 1px solid #e2e8f1;
    border-radius: 12px;
    background: #fff;
    color: #5b687b;
    line-height: 1.6;
  }

  @media (max-width: 850px) {
    .cuadricula {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .pagina {
      width: min(100% - 28px, 1100px);
      padding-top: 38px;
    }

    .cuadricula {
      grid-template-columns: 1fr;
    }
  }
</style>