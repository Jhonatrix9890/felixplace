---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDatabase } from '@netlify/database';
import { actions } from 'astro:actions';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';
import ShareBar from '../../components/ShareBar.astro';

const slug = Astro.params.slug ?? '';
const db = getDatabase();

const [post] = await db.sql`
  SELECT
    id,
    title,
    slug,
    category,
    video_url,
    description,
    body_markdown,
    author_name,
    published_at,
    seo_title,
    seo_description
  FROM posts
  WHERE slug = ${slug}
    AND kind = 'tutorial'
    AND status = 'published'
  LIMIT 1
`;

if (!post) {
  Astro.response.status = 404;
}

function obtenerUrlVideo(url: string | null | undefined): string | null {
  if (!url) return null;

  try {
    const parsedUrl = new URL(url);
    const host = parsedUrl.hostname.toLowerCase();
    let videoId = '';

    if (host === 'youtu.be') {
      videoId = parsedUrl.pathname.split('/').filter(Boolean)[0] ?? '';
    } else if (
      host === 'youtube.com' ||
      host === 'www.youtube.com' ||
      host === 'm.youtube.com'
    ) {
      if (parsedUrl.pathname === '/watch') {
        videoId = parsedUrl.searchParams.get('v') ?? '';
      } else if (
        parsedUrl.pathname.startsWith('/shorts/') ||
        parsedUrl.pathname.startsWith('/embed/')
      ) {
        videoId = parsedUrl.pathname.split('/').filter(Boolean)[1] ?? '';
      }
    }

    if (!/^[a-zA-Z0-9_-]{11}$/.test(videoId)) {
      return null;
    }

    return `https://www.youtube-nocookie.com/embed/${videoId}`;
  } catch {
    return null;
  }
}

const videoEmbedUrl = obtenerUrlVideo(post?.video_url);
const videoId = videoEmbedUrl?.split('/').at(-1) ?? '';
const videoThumbnailUrl = videoId
  ? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`
  : undefined;

const comments = post
  ? await db.sql`
      SELECT display_name, body, created_at
      FROM comments
      WHERE post_id = ${post.id}
        AND status = 'approved'
      ORDER BY created_at ASC
      LIMIT 50
    `
  : [];

const commentResult = Astro.getActionResult(actions.submitComment);
const commentError = commentResult?.error?.message;
const commentSent = Boolean(commentResult?.data);

const pageTitle = post?.seo_title || post?.title || 'Tutorial no encontrado';
const pageDescription =
  post?.seo_description ||
  post?.description ||
  'Tutoriales de tecnología en FelixPlace.';

const siteUrl = Astro.site ?? new URL('https://felixplace.com');
const canonicalUrl = post
  ? new URL(`/tutoriales/${post.slug}`, siteUrl).toString()
  : '';

const publishedTime = post?.published_at
  ? new Date(post.published_at).toISOString()
  : '';

const tutorialJsonLd = post
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: post.title,
      description: post.description || undefined,
      mainEntityOfPage: canonicalUrl,
      image: videoThumbnailUrl ? [videoThumbnailUrl] : undefined,
      datePublished: publishedTime || undefined,
      author: {
        '@type': 'Person',
        name: post.author_name,
      },
      publisher: {
        '@type': 'Organization',
        name: 'FelixPlace',
        logo: {
          '@type': 'ImageObject',
          url: 'https://felixplace.com/assets/logo.png',
        },
      },
      inLanguage: 'es-EC',
    }).replace(/</g, '\\u003c')
  : '';

const articleHtml = post
  ? sanitizeHtml(await marked.parse(post.body_markdown || ''))
  : '';
---

<BaseLayout
  title={`${pageTitle} | FelixPlace`}
  description={pageDescription}
  canonical={canonicalUrl || undefined}
  ogType="article"
  ogImage={videoThumbnailUrl}
  ogImageAlt={post?.title || ''}
>
  {post && (
    <Fragment slot="head">
      {publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )}
      <script
        type="application/ld+json"
        set:html={tutorialJsonLd}
      ></script>
    </Fragment>
  )}

  <main class="pagina">
    {post ? (
      <>
        <article class="articulo">
          <a class="volver" href="/tutoriales">← Volver a tutoriales</a>

          <p class="categoria">{post.category || 'Tecnología'} · Tutorial</p>
          <h1>{post.title}</h1>

          {post.description && <p class="descripcion">{post.description}</p>}

          <p class="autor">Por {post.author_name}</p>

          {videoEmbedUrl ? (
            <div class="video">
              <iframe
                src={videoEmbedUrl}
                title={`Video de YouTube: ${post.title}`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          ) : (
            <p class="aviso error">
              Este tutorial todavía no tiene un enlace de YouTube válido.
            </p>
          )}

          <div class="contenido" set:html={articleHtml}></div>
        </article>
        <ShareBar url={canonicalUrl} title={post.title} />
        <section class="comentarios">
          <h2>Comentarios</h2>
          <p class="ayuda">
            Tu comentario será revisado antes de aparecer públicamente.
          </p>

          {commentSent && (
            <p class="aviso">
              Gracias por comentar. Tu comentario quedó pendiente de revisión.
            </p>
          )}

          {commentError && (
            <p class="aviso error">
              No se pudo enviar el comentario. Revisa los datos e inténtalo de
              nuevo.
            </p>
          )}

          {comments.length === 0 ? (
            <p>Aún no hay comentarios aprobados.</p>
          ) : (
            <div class="lista-comentarios">
              {comments.map((comment) => (
                <article class="comentario">
                  <h3>{comment.display_name}</h3>
                  <p>{comment.body}</p>
                </article>
              ))}
            </div>
          )}

          <h3>Escribe un comentario</h3>

          <form method="POST" action={actions.submitComment}>
            <input type="hidden" name="post_id" value={post.id} />

            <label for="display_name">Tu nombre</label>
            <input
              id="display_name"
              name="display_name"
              type="text"
              minlength="2"
              maxlength="80"
              required
            />

            <label for="body">Comentario</label>
            <textarea
              id="body"
              name="body"
              minlength="2"
              maxlength="2000"
              rows="5"
              required
            ></textarea>

            <div class="campo-oculto" aria-hidden="true">
              <label for="website">Deja este campo vacío</label>
              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <button type="submit">Enviar comentario</button>
          </form>
        </section>
      </>
    ) : (
      <section class="articulo">
        <h1>Tutorial no encontrado</h1>
        <p>Este tutorial no existe o todavía no está publicado.</p>
        <a class="volver" href="/tutoriales">Volver a tutoriales</a>
      </section>
    )}
  </main>

</BaseLayout>

<style>
  .pagina {
    width: min(100% - 40px, 820px);
    margin: 0 auto;
    padding: 40px 0 16px;
  }

  .articulo,
  .comentarios {
    margin-bottom: 24px;
    padding: clamp(1.25rem, 5vw, 2.5rem);
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px rgb(23 32 51 / 5%);
  }

  .volver {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  .volver:hover {
    text-decoration: underline;
  }

  .categoria {
    margin: 1.5rem 0 0.5rem;
    color: #1769aa;
    font-size: 0.85rem;
    font-weight: 700;
  }

  h1 {
    margin: 0 0 1rem;
    color: #172033;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.15;
  }

  h2 {
    color: #172033;
  }

  .descripcion,
  .ayuda,
  .autor {
    color: #596579;
    line-height: 1.6;
  }

  .video {
    position: relative;
    width: 100%;
    margin: 1.5rem 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    background: #101827;
  }

  .video iframe {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .contenido {
    color: #253149;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .contenido :global(h2),
  .contenido :global(h3) {
    margin-top: 2rem;
    line-height: 1.3;
  }

  .contenido :global(a) {
    color: #1769aa;
  }

  .lista-comentarios {
    display: grid;
    gap: 12px;
    margin: 20px 0;
  }

  .comentario {
    padding: 16px;
    border: 1px solid #e4e8ef;
    border-radius: 8px;
  }

  .comentario h3 {
    margin: 0 0 8px;
  }

  .comentario p {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  form {
    display: grid;
    gap: 10px;
    margin-top: 24px;
  }

  label {
    margin-top: 8px;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid #cbd3df;
    border-radius: 7px;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  button {
    justify-self: start;
    padding: 12px 16px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .aviso {
    padding: 12px;
    border-radius: 8px;
    background: #edf4fb;
    line-height: 1.5;
  }

  .error {
    background: #fff1f0;
    color: #9b2525;
  }

  .campo-oculto {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .pagina {
      width: min(100% - 32px, 820px);
      padding-top: 24px;
    }
  }
</style>