---
const title = 'Acceso de administración | FelixPlace';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>

  <body>
    <main class="login-card">
      <a class="brand" href="/">FelixPlace</a>
      <h1>Administración</h1>
      <p class="intro">Ingresa con tu cuenta autorizada para continuar.</p>

      <form id="login-form">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />

        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />

        <button id="login-button" type="submit">Iniciar sesión</button>
      </form>

      <form id="invite-form" hidden>
        <p class="intro">
          Acepta la invitación creando una contraseña para tu cuenta.
        </p>

        <label for="invite-password">Crear contraseña</label>
        <input
          id="invite-password"
          name="invite-password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />

        <label for="invite-password-confirm">Repetir contraseña</label>
        <input
          id="invite-password-confirm"
          name="invite-password-confirm"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />

        <button id="invite-button" type="submit">Aceptar invitación</button>
      </form>

      <p id="status" role="status" aria-live="polite"></p>
    </main>

    <script>
      import {
        acceptInvite,
        handleAuthCallback,
        login,
      } from '@netlify/identity';

      const loginForm =
        document.querySelector<HTMLFormElement>('#login-form');
      const inviteForm =
        document.querySelector<HTMLFormElement>('#invite-form');
      const status = document.querySelector<HTMLParagraphElement>('#status');
      const loginButton =
        document.querySelector<HTMLButtonElement>('#login-button');
      const inviteButton =
        document.querySelector<HTMLButtonElement>('#invite-button');
      const emailInput =
        document.querySelector<HTMLInputElement>('#email');
      const loginPasswordInput =
        document.querySelector<HTMLInputElement>('#password');
      const invitePasswordInput =
        document.querySelector<HTMLInputElement>('#invite-password');
      const invitePasswordConfirmInput =
        document.querySelector<HTMLInputElement>('#invite-password-confirm');

      let inviteToken: string | undefined;

      function showMessage(message: string) {
        if (status) status.textContent = message;
      }

      try {
        const result = await handleAuthCallback();

        if (result?.type === 'invite') {
          inviteToken = result.token;

          if (!inviteToken) {
            throw new Error('No se recibió el token de invitación.');
          }

          if (loginForm) loginForm.hidden = true;
          if (inviteForm) inviteForm.hidden = false;

          showMessage('Crea una contraseña para activar tu cuenta.');
        } else if (result?.type === 'confirmation') {
          showMessage('Correo confirmado. Ahora puedes iniciar sesión.');
        }
      } catch {
        showMessage(
          'No se pudo procesar el enlace. Puede haber vencido; solicita una nueva invitación.',
        );
      }

      inviteForm?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const password = invitePasswordInput?.value;
        const passwordConfirmation = invitePasswordConfirmInput?.value;

        if (!inviteToken) {
          showMessage('No encontramos un enlace de invitación válido.');
          return;
        }

        if (!password || !passwordConfirmation) {
          showMessage('Completa los dos campos de contraseña.');
          return;
        }

        if (password !== passwordConfirmation) {
          showMessage('Las contraseñas no coinciden.');
          return;
        }

        if (inviteButton) inviteButton.disabled = true;
        showMessage('Activando la cuenta…');

        try {
          const invitedUser = await acceptInvite(inviteToken, password);

          if (emailInput && invitedUser.email) {
            emailInput.value = invitedUser.email;
          }

          if (inviteForm) inviteForm.hidden = true;
          if (loginForm) loginForm.hidden = false;

          showMessage(
            'Cuenta activada. Inicia sesión con la contraseña que acabas de crear.',
          );
        } catch {
          showMessage(
            'No se pudo aceptar la invitación. Revisa el enlace o solicita uno nuevo.',
          );
          if (inviteButton) inviteButton.disabled = false;
        }
      });

      loginForm?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const email = emailInput?.value.trim();
        const password = loginPasswordInput?.value;

        if (!email || !password) return;

        if (loginButton) loginButton.disabled = true;
        showMessage('Verificando acceso…');

        try {
          await login(email, password);
          window.location.href = '/admin';
        } catch {
          showMessage(
            'No se pudo iniciar sesión. Revisa el correo y la contraseña.',
          );
          if (loginButton) loginButton.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    background: #f3f5f8;
    color: #172033;
    font-family: Arial, sans-serif;
  }

  .login-card {
    width: min(100%, 420px);
    padding: 36px;
    border: 1px solid #e4e8ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 16px 45px rgb(20 35 60 / 10%);
  }

  .brand {
    color: #1769aa;
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
  }

  h1 {
    margin: 28px 0 8px;
  }

  .intro {
    margin: 0 0 24px;
    color: #657084;
    line-height: 1.5;
  }

  label {
    display: block;
    margin: 16px 0 7px;
    font-weight: 600;
  }

  input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccd3df;
    border-radius: 8px;
    font: inherit;
  }

  button {
    width: 100%;
    margin-top: 22px;
    padding: 13px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  #status {
    min-height: 1.5em;
    color: #4c5a70;
    line-height: 1.4;
  }
</style>