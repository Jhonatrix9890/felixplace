---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDatabase } from '@netlify/database';

export const prerender = false;

type CourseRow = {
  title: string;
  slug: string;
  summary: string;
  cover_image_url: string | null;
  instructor_name: string;
  level: string | null;
  language: string;
  access_model: 'free' | 'paid' | 'external';
  price: string | number | null;
  currency: string;
  checkout_url: string | null;
};

const db = getDatabase();

const courses = await db.sql<CourseRow>`
  SELECT
    title,
    slug,
    summary,
    cover_image_url,
    instructor_name,
    level,
    language,
    access_model,
    price,
    currency,
    checkout_url
  FROM courses
  WHERE status = 'published'
  ORDER BY published_at DESC NULLS LAST, created_at DESC
  LIMIT 24
`;

const modeloAcceso = (model: CourseRow['access_model']) => {
  if (model === 'free') return 'Gratis';
  if (model === 'paid') return 'De pago';
  return 'Curso externo';
};

const precioFormateado = (
  price: CourseRow['price'],
  currency: string,
) => {
  if (price === null) return '';

  const amount = Number(price);
  const currencyCode = currency.trim() || 'USD';

  if (!Number.isFinite(amount)) {
    return `${currencyCode} ${price}`;
  }

  try {
    return new Intl.NumberFormat('es-EC', {
      style: 'currency',
      currency: currencyCode,
    }).format(amount);
  } catch {
    return `${currencyCode} ${amount.toFixed(2)}`;
  }
};
---

<BaseLayout
  title="Cursos de tecnología | FelixPlace"
  description="Explora cursos de tecnología y aprendizaje práctico en FelixPlace."
>
  <main class="pagina">
    <header class="intro">
      <p class="etiqueta">APRENDE A TU RITMO</p>
      <h1>Cursos de tecnología</h1>
      <p>
        Cursos prácticos para ayudarte a desarrollar nuevas habilidades
        tecnológicas.
      </p>
    </header>

    {courses.length === 0 ? (
      <section class="vacio">
        <h2>Próximamente</h2>
        <p>
          Estamos preparando nuestros primeros cursos. Mientras tanto, puedes
          explorar las noticias y los tutoriales de FelixPlace.
        </p>

        <div class="enlaces">
          <a href="/noticias">Ver noticias</a>
          <a href="/tutoriales">Ver tutoriales</a>
        </div>
      </section>
    ) : (
      <section class="catalogo" aria-label="Catálogo de cursos">
        {courses.map((course) => (
          <article class="curso">
            {course.cover_image_url ? (
              <img
                class="portada"
                src={course.cover_image_url}
                alt={`Portada del curso ${course.title}`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="portada-vacia" aria-hidden="true">
                <span>FELIXPLACE</span>
                <small>CURSO DE TECNOLOGÍA</small>
              </div>
            )}

            <div class="contenido">
              <p class="tipo">{modeloAcceso(course.access_model)}</p>
              <h2>{course.title}</h2>
              <p class="resumen">{course.summary}</p>

              <dl>
                <div>
                  <dt>Instructor</dt>
                  <dd>{course.instructor_name}</dd>
                </div>

                {course.level && (
                  <div>
                    <dt>Nivel</dt>
                    <dd>{course.level}</dd>
                  </div>
                )}

                <div>
                  <dt>Idioma</dt>
                  <dd>{course.language}</dd>
                </div>

                {course.price !== null && (
                  <div>
                    <dt>Precio</dt>
                    <dd>{precioFormateado(course.price, course.currency)}</dd>
                  </div>
                )}
              </dl>

              {course.checkout_url ? (
                <a
                  class="boton"
                  href={course.checkout_url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {course.access_model === 'free'
                    ? 'Acceder al curso'
                    : 'Ver curso'}
                </a>
              ) : (
                <span class="proximamente">
                  Más información próximamente
                </span>
              )}
            </div>
          </article>
        ))}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .pagina {
    width: min(100% - 40px, 1100px);
    margin: 0 auto;
    padding: 48px 0 72px;
  }

  .intro {
    max-width: 820px;
    margin-bottom: 32px;
  }

  .etiqueta,
  .tipo {
    color: #1769aa;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 8px 0;
    color: #102247;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }

  .intro > p:last-child,
  .resumen {
    color: #596579;
    line-height: 1.7;
  }

  .catalogo {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }

  .curso {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #e1e7ef;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px rgb(23 32 51 / 5%);
  }

  .portada,
  .portada-vacia {
    display: flex;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .portada {
    object-fit: cover;
  }

  .portada-vacia {
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 8px;
    background: linear-gradient(135deg, #102b55, #1769aa);
    color: #fff;
  }

  .portada-vacia span {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .portada-vacia small {
    color: #d8e9f7;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .contenido {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px;
  }

  .tipo {
    align-self: flex-start;
    margin: 0 0 10px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #edf4fb;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .curso h2,
  .vacio h2 {
    color: #102247;
  }

  .curso h2 {
    margin: 0 0 8px;
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .resumen {
    margin: 0;
  }

  dl {
    display: grid;
    gap: 10px;
    margin: 20px 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  dt {
    color: #647084;
  }

  dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }

  .boton {
    align-self: flex-start;
    margin-top: auto;
    padding: 11px 16px;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .boton:hover {
    background: #12558b;
  }

  .proximamente {
    margin-top: auto;
    color: #647084;
    font-size: 0.95rem;
  }

  .vacio {
    max-width: 440px;
    padding: 24px;
    border: 1px solid #dce5ef;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px rgb(23 32 51 / 5%);
  }

  .vacio h2 {
    margin-top: 0;
  }

  .vacio p {
    color: #596579;
    line-height: 1.7;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 20px;
  }

  .enlaces a {
    color: #1769aa;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .pagina {
      width: min(100% - 32px, 1100px);
      padding-top: 32px;
    }
  }
</style>