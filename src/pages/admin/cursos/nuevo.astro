---
import { actions } from 'astro:actions';
import { getUser } from '@netlify/identity';

export const prerender = false;

const user = await getUser();

if (!user) {
  return Astro.redirect('/admin/login');
}

const tienePermisoEditorial =
  user.roles?.some((role) => role === 'admin' || role === 'editor') ?? false;

if (!tienePermisoEditorial) {
  return new Response('Tu cuenta no tiene permiso para crear cursos.', {
    status: 403,
  });
}

const actionResult = Astro.getActionResult(actions.createCourse);

if (actionResult && !actionResult.error) {
  return Astro.redirect('/admin/cursos/nuevo?guardado=1');
}

const errorMessage = actionResult?.error?.message;
const guardado = Astro.url.searchParams.get('guardado') === '1';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nuevo curso | FelixPlace</title>
  </head>

  <body>
    <main class="panel">
      <a class="volver" href="/admin">← Volver al panel</a>

      <p class="marca">FELIXPLACE</p>
      <h1>Crear curso</h1>
      <p class="ayuda">El curso se guardará como borrador.</p>

      {guardado && (
        <p class="mensaje exito" role="status">
          Curso guardado correctamente como borrador.
        </p>
      )}

      {errorMessage && (
        <p class="mensaje error" role="alert">{errorMessage}</p>
      )}

      <form method="POST" action={actions.createCourse}>
        <label for="title">Nombre del curso</label>
        <input
          id="title"
          name="title"
          type="text"
          minlength="5"
          maxlength="180"
          required
        />

        <label for="slug">Slug de la URL</label>
        <input
          id="slug"
          name="slug"
          type="text"
          pattern="[a-z0-9]+(-[a-z0-9]+)*"
          maxlength="180"
          required
        />
        <small>Se genera desde el nombre y puedes editarlo.</small>

        <label for="summary">Resumen</label>
        <textarea
          id="summary"
          name="summary"
          rows="3"
          maxlength="350"
        ></textarea>

        <label for="description_markdown">Descripción del curso</label>
        <textarea
          id="description_markdown"
          name="description_markdown"
          rows="10"
          maxlength="20000"
          placeholder="Explica qué aprenderá el estudiante."
        ></textarea>

        <label for="cover_image_url">URL de la imagen de portada</label>
        <input
          id="cover_image_url"
          name="cover_image_url"
          type="url"
          maxlength="2048"
          placeholder="https://..."
        />

        <label for="level">Nivel</label>
        <select id="level" name="level" required>
          <option value="beginner">Principiante</option>
          <option value="intermediate">Intermedio</option>
          <option value="advanced">Avanzado</option>
        </select>

        <label for="language">Idioma</label>
        <input
          id="language"
          name="language"
          type="text"
          value="es"
          minlength="2"
          maxlength="10"
          required
        />
        <small>Usa “es” para español.</small>

        <label for="access_model">Tipo de acceso</label>
        <select id="access_model" name="access_model" required>
          <option value="free">Gratuito</option>
          <option value="paid">De pago</option>
          <option value="external">Enlace externo</option>
        </select>

        <div id="price-fields" class="grupo-condicional" hidden>
          <label for="price">Precio</label>
          <input
            id="price"
            name="price"
            type="number"
            min="0"
            max="100000"
            step="0.01"
          />

          <label for="currency">Moneda</label>
          <input
            id="currency"
            name="currency"
            type="text"
            value="USD"
            minlength="3"
            maxlength="3"
          />
          <small>Por ejemplo: USD.</small>
        </div>

        <div id="checkout-fields" class="grupo-condicional" hidden>
          <label for="checkout_url">Enlace para adquirir el curso</label>
          <input
            id="checkout_url"
            name="checkout_url"
            type="url"
            maxlength="2048"
            placeholder="https://..."
          />
        </div>

        <label for="seo_title">Título SEO (opcional)</label>
        <input
          id="seo_title"
          name="seo_title"
          type="text"
          maxlength="180"
        />

        <label for="seo_description">Descripción SEO (opcional)</label>
        <textarea
          id="seo_description"
          name="seo_description"
          rows="3"
          maxlength="200"
        ></textarea>

        <button type="submit">Guardar curso</button>
      </form>
    </main>

    <script>
      const titleInput = document.querySelector<HTMLInputElement>('#title');
      const slugInput = document.querySelector<HTMLInputElement>('#slug');
      const accessInput =
        document.querySelector<HTMLSelectElement>('#access_model');
      const priceFields = document.querySelector<HTMLDivElement>('#price-fields');
      const checkoutFields =
        document.querySelector<HTMLDivElement>('#checkout-fields');
      const priceInput = document.querySelector<HTMLInputElement>('#price');
      const checkoutInput =
        document.querySelector<HTMLInputElement>('#checkout_url');

      let slugEditado = false;

      function crearSlug(texto: string) {
        return texto
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');
      }

      titleInput?.addEventListener('input', () => {
        if (titleInput && slugInput && !slugEditado) {
          slugInput.value = crearSlug(titleInput.value);
        }
      });

      slugInput?.addEventListener('input', () => {
        if (slugInput) {
          slugEditado = true;
          slugInput.value = crearSlug(slugInput.value);
        }
      });

      function actualizarAcceso() {
        const tipo = accessInput?.value;

        if (priceFields && priceInput) {
          const requierePrecio = tipo === 'paid';
          priceFields.hidden = !requierePrecio;
          priceInput.required = requierePrecio;
        }

        if (checkoutFields && checkoutInput) {
          const requiereEnlace = tipo === 'external';
          checkoutFields.hidden = !requiereEnlace;
          checkoutInput.required = requiereEnlace;
        }
      }

      accessInput?.addEventListener('change', actualizarAcceso);
      actualizarAcceso();
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding: 24px;
    background: #f3f5f8;
    color: #172033;
    font-family: Arial, sans-serif;
  }

  .panel {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 32px;
    border: 1px solid #e4e8ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 16px 45px rgb(20 35 60 / 8%);
  }

  .volver {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  .marca {
    margin-top: 28px;
    color: #1769aa;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .ayuda,
  small {
    color: #596579;
    line-height: 1.5;
  }

  form {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  label {
    margin-top: 10px;
    font-weight: 700;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd3df;
    border-radius: 8px;
    color: inherit;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  .grupo-condicional {
    display: grid;
    gap: 10px;
    padding: 16px;
    border-radius: 8px;
    background: #f4f7fb;
  }

  .grupo-condicional[hidden] {
    display: none;
  }

  button {
    margin-top: 18px;
    padding: 14px 18px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .mensaje {
    padding: 12px;
    border-radius: 8px;
    line-height: 1.5;
  }

  .exito {
    background: #e9f8ef;
    color: #176236;
  }

  .error {
    background: #fff0f0;
    color: #9b2020;
  }

  @media (max-width: 600px) {
    .panel {
      padding: 22px;
    }
  }
</style>