---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDatabase } from '@netlify/database';
import { actions } from 'astro:actions';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';
import ShareBar from '../../components/ShareBar.astro';

const slug = Astro.params.slug ?? '';
const db = getDatabase();

const [post] = await db.sql`
  SELECT
    id,
    title,
    slug,
    category,
    image_url,
    image_alt,
    description,
    body_markdown,
    author_name,
    published_at,
    seo_title,
    seo_description
  FROM posts
  WHERE slug = ${slug}
    AND kind = 'news'
    AND status = 'published'
  LIMIT 1
`;

if (!post) {
  Astro.response.status = 404;
}

const comments = post
  ? await db.sql`
      SELECT display_name, body, created_at
      FROM comments
      WHERE post_id = ${post.id}
        AND status = 'approved'
      ORDER BY created_at ASC
      LIMIT 50
    `
  : [];

const commentResult = Astro.getActionResult(actions.submitComment);
const commentError = commentResult?.error?.message;
const commentSent = Boolean(commentResult?.data);

const pageTitle = post?.seo_title || post?.title || 'Noticia no encontrada';
const pageDescription =
  post?.seo_description ||
  post?.description ||
  'Noticias de tecnología en FelixPlace.';

const siteUrl = Astro.site ?? new URL('https://felixplace.com');
const canonicalUrl = post
  ? new URL(`/noticias/${post.slug}`, siteUrl).toString()
  : '';

const publishedTime = post?.published_at
  ? new Date(post.published_at).toISOString()
  : '';

const articleJsonLd = post
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: post.title,
      description: pageDescription,
      mainEntityOfPage: canonicalUrl,
      image: post.image_url ? [post.image_url] : undefined,
      datePublished: publishedTime || undefined,
      author: {
        '@type': 'Person',
        name: post.author_name,
      },
      publisher: {
        '@type': 'Organization',
        name: 'FelixPlace',
        logo: {
          '@type': 'ImageObject',
          url: 'https://felixplace.com/assets/logo.png',
        },
      },
      inLanguage: 'es-EC',
    }).replace(/</g, '\\u003c')
  : '';

const articleHtml = post
  ? sanitizeHtml(await marked.parse(post.body_markdown || ''))
  : '';
---

<BaseLayout
  title={`${pageTitle} | FelixPlace`}
  description={pageDescription}
  canonical={canonicalUrl || undefined}
  ogType="article"
  ogImage={post?.image_url || undefined}
  ogImageAlt={post?.image_alt || post?.title || ''}
>
  {post && (
    <Fragment slot="head">
      {publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )}
      <script
        type="application/ld+json"
        set:html={articleJsonLd}
      ></script>
    </Fragment>
  )}

  <main class="pagina">
    {post ? (
      <>
        <article class="articulo">
          <a class="volver" href="/noticias">← Volver a noticias</a>

          <p class="categoria">{post.category || 'Tecnología'} · Noticia</p>
          <h1>{post.title}</h1>

          {post.description && <p class="descripcion">{post.description}</p>}

          <p class="autor">Por {post.author_name}</p>

          {post.image_url && (
            <img
              class="imagen-portada"
              src={post.image_url}
              alt={post.image_alt || post.title}
              fetchpriority="high"
            />
          )}

          <div class="contenido" set:html={articleHtml}></div>
        </article>
        <ShareBar url={canonicalUrl} title={post.title} />
        <section class="comentarios">
          <h2>Comentarios</h2>
          <p class="ayuda">
            Tu comentario será revisado antes de aparecer públicamente.
          </p>

          {commentSent && (
            <p class="aviso exito" aria-live="polite">
              Gracias por comentar. Tu comentario quedó pendiente de revisión.
            </p>
          )}

          {commentError && (
            <p class="aviso error" aria-live="polite">
              No se pudo enviar el comentario. Revisa los datos e inténtalo de
              nuevo.
            </p>
          )}

          {comments.length === 0 ? (
            <p>Aún no hay comentarios aprobados.</p>
          ) : (
            <div class="lista-comentarios">
              {comments.map((comment) => (
                <article class="comentario">
                  <h3>{comment.display_name}</h3>
                  <p>{comment.body}</p>
                </article>
              ))}
            </div>
          )}

          <h3>Escribe un comentario</h3>

          <form method="POST" action={actions.submitComment}>
            <input type="hidden" name="post_id" value={post.id} />

            <label for="display_name">Tu nombre</label>
            <input
              id="display_name"
              name="display_name"
              type="text"
              minlength="2"
              maxlength="80"
              required
            />

            <label for="body">Comentario</label>
            <textarea
              id="body"
              name="body"
              minlength="2"
              maxlength="2000"
              rows="5"
              required
            ></textarea>

            <div class="campo-oculto" aria-hidden="true">
              <label for="website">Deja este campo vacío</label>
              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <button type="submit">Enviar comentario</button>
          </form>
        </section>
      </>
    ) : (
      <section class="articulo">
        <h1>Noticia no encontrada</h1>
        <p>Esta noticia no existe o todavía no está publicada.</p>
        <a class="volver" href="/noticias">Volver a noticias</a>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .pagina {
    width: min(100% - 40px, 820px);
    margin: 0 auto;
    padding: 40px 0 16px;
  }

  .articulo,
  .comentarios {
    margin-bottom: 24px;
    padding: clamp(1.25rem, 5vw, 2.5rem);
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px rgb(23 32 51 / 5%);
  }

  .volver {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  .volver:hover {
    text-decoration: underline;
  }

  .categoria {
    margin: 1.5rem 0 0.5rem;
    color: #1769aa;
    font-size: 0.85rem;
    font-weight: 700;
  }

  h1 {
    margin: 0 0 1rem;
    color: #172033;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.15;
  }

  h2 {
    color: #172033;
  }

  .descripcion,
  .ayuda,
  .autor {
    color: #596579;
    line-height: 1.6;
  }

  .imagen-portada {
    display: block;
    width: 100%;
    max-height: 480px;
    margin: 1.5rem 0;
    border-radius: 10px;
    object-fit: cover;
  }

  .contenido {
    color: #253149;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .contenido :global(h2),
  .contenido :global(h3) {
    margin-top: 2rem;
    line-height: 1.3;
  }

  .contenido :global(a) {
    color: #1769aa;
  }

  .contenido :global(img) {
    max-width: 100%;
    height: auto;
  }

  .lista-comentarios {
    display: grid;
    gap: 12px;
    margin: 20px 0;
  }

  .comentario {
    padding: 16px;
    border: 1px solid #e4e8ef;
    border-radius: 8px;
  }

  .comentario h3 {
    margin: 0 0 8px;
  }

  .comentario p {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  form {
    display: grid;
    gap: 10px;
    margin-top: 24px;
  }

  label {
    margin-top: 8px;
    font-weight: 700;
  }

  input,
  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border: 1px solid #cbd3df;
    border-radius: 7px;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  button {
    justify-self: start;
    padding: 12px 16px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .aviso {
    padding: 12px;
    border-radius: 8px;
    line-height: 1.5;
  }

  .exito {
    background: #eaf7ee;
    color: #176b35;
  }

  .error {
    background: #fff1f0;
    color: #9b2525;
  }

  .campo-oculto {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .pagina {
      width: min(100% - 32px, 820px);
      padding-top: 24px;
    }
  }
</style>