---
import { getUser } from '@netlify/identity';
import { getDatabase } from '@netlify/database';
import { actions } from 'astro:actions';

export const prerender = false;

const user = await getUser();

if (!user) {
  return Astro.redirect('/admin/login');
}

if (!user.roles?.includes('admin')) {
  return new Response('Solo una cuenta administradora puede ver estos mensajes.', {
    status: 403,
  });
}

type ContactMessage = {
  id: string;
  message_type: 'contact' | 'suggestion' | 'correction';
  name: string;
  email: string;
  subject: string;
  message: string;
  status: 'pending' | 'read' | 'answered' | 'spam';
  created_at: string | Date;
};

const statusResult = Astro.getActionResult(
  actions.updateContactMessageStatus,
);

const successMessage = statusResult?.data
  ? 'Se actualizó el estado del mensaje.'
  : '';

const actionError = statusResult?.error?.message;

let messages: ContactMessage[] = [];
let loadError = '';

try {
  const db = getDatabase();

  messages = (await db.sql`
    SELECT
      id,
      message_type,
      name,
      email,
      subject,
      message,
      status,
      created_at
    FROM contact_messages
    WHERE status <> 'spam'
    ORDER BY created_at DESC
    LIMIT 100
  `) as unknown as ContactMessage[];
} catch (error) {
  loadError =
    error instanceof Error
      ? error.message
      : 'No se pudieron cargar los mensajes.';
}

const tipoMensaje = (type: ContactMessage['message_type']) => {
  const tipos: Record<ContactMessage['message_type'], string> = {
    contact: 'Consulta',
    suggestion: 'Sugerencia',
    correction: 'Corrección',
  };

  return tipos[type];
};

const estadoMensaje = (status: ContactMessage['status']) => {
  const estados: Record<ContactMessage['status'], string> = {
    pending: 'Pendiente',
    read: 'Leído',
    answered: 'Respondido',
    spam: 'Spam',
  };

  return estados[status];
};

const fechaMensaje = (date: string | Date) =>
  new Date(date).toLocaleString('es-EC', {
    dateStyle: 'medium',
    timeStyle: 'short',
  });
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Mensajes de contacto | FelixPlace</title>
  </head>

  <body>
    <main class="panel">
      <header class="encabezado">
        <div>
          <a class="volver" href="/admin">← Volver al panel</a>
          <p class="marca">FELIXPLACE</p>
          <h1>Mensajes de contacto</h1>
          <p class="sesion">
            Bandeja privada · Sesión iniciada como <strong>{user.email}</strong>
          </p>
        </div>

        <button id="logout-button" class="secundario" type="button">
          Cerrar sesión
        </button>
      </header>

      {successMessage && <p class="aviso exito">{successMessage}</p>}
      {actionError && <p class="aviso error">{actionError}</p>}

      {loadError ? (
        <p class="aviso error">No se pudieron cargar los mensajes: {loadError}</p>
      ) : messages.length === 0 ? (
        <p class="aviso">No hay mensajes pendientes de revisión.</p>
      ) : (
        <section class="lista" aria-label="Mensajes recibidos">
          {messages.map((item) => (
            <article class="mensaje">
              <div class="encabezado-mensaje">
                <span class="tipo">{tipoMensaje(item.message_type)}</span>
                <span class={`estado estado-${item.status}`}>
                  {estadoMensaje(item.status)}
                </span>
              </div>

              <h2>{item.subject}</h2>
              <p class="autor">
                De <strong>{item.name}</strong> ·
                <a href={`mailto:${item.email}`}>{item.email}</a>
              </p>
              <p class="fecha">{fechaMensaje(item.created_at)}</p>
              <p class="contenido">{item.message}</p>

              <form method="POST" action={actions.updateContactMessageStatus}>
                <input type="hidden" name="id" value={item.id} />
                <button type="submit" name="status" value="read">
                  Marcar leído
                </button>
                <button type="submit" name="status" value="answered">
                  Marcar respondido
                </button>
                <button
                  class="boton-spam"
                  type="submit"
                  name="status"
                  value="spam"
                >
                  Marcar spam
                </button>
              </form>
            </article>
          ))}
        </section>
      )}
    </main>

    <script>
      import { logout } from '@netlify/identity';

      document
        .querySelector('#logout-button')
        ?.addEventListener('click', async () => {
          await logout();
          window.location.href = '/admin/login';
        });
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    margin: 0;
    padding: 32px 20px;
    background: #f3f5f8;
    color: #172033;
    font-family: Arial, sans-serif;
  }

  .panel {
    width: min(100%, 960px);
    margin: 0 auto;
    padding: 32px;
    border: 1px solid #e4e8ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 16px 45px rgb(20 35 60 / 8%);
  }

  .encabezado,
  .encabezado-mensaje {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .encabezado {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e4e8ef;
  }

  .volver {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  .marca {
    margin: 22px 0 8px;
    color: #1769aa;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 8px;
  }

  .sesion,
  .autor,
  .fecha {
    color: #647084;
  }

  .sesion {
    margin-bottom: 0;
  }

  .lista {
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }

  .mensaje {
    padding: 20px;
    border: 1px solid #e4e8ef;
    border-radius: 10px;
  }

  .encabezado-mensaje {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .tipo,
  .estado {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 999px;
    background: #edf4fb;
    color: #1769aa;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .estado-leido {
    background: #f1f3f6;
    color: #465166;
  }

  .estado-respondido {
    background: #eaf7ee;
    color: #176b35;
  }

  .mensaje h2 {
    margin: 16px 0 8px;
    font-size: 1.2rem;
  }

  .autor {
    margin-bottom: 5px;
    overflow-wrap: anywhere;
  }

  .autor a {
    color: #1769aa;
  }

  .fecha {
    font-size: 0.9rem;
  }

  .contenido {
    margin: 18px 0;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  form {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  button {
    padding: 10px 13px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .boton-spam {
    background: #a83232;
  }

  .secundario {
    background: #edf2f7;
    color: #172033;
  }

  .aviso {
    padding: 14px;
    border-radius: 8px;
    background: #f3f6fa;
  }

  .exito {
    background: #eaf7ee;
    color: #176b35;
  }

  .error {
    background: #fff1f0;
    color: #9b2525;
  }

  @media (max-width: 640px) {
    .panel {
      padding: 22px 18px;
    }

    .encabezado {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>