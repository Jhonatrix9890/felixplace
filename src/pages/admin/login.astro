---
const title = 'Acceso de administración | FelixPlace';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>

  <body>
    <main class="login-card">
      <a class="brand" href="/">FelixPlace</a>
      <h1>Administración</h1>
      <p class="intro">Ingresa con tu cuenta autorizada para continuar.</p>

      <form id="login-form">
        <label for="email">Correo electrónico</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />

        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />

        <button id="login-button" type="submit">Iniciar sesión</button>
        <p id="status" role="status" aria-live="polite"></p>
      </form>
    </main>

    <script>
      import { handleAuthCallback, login } from '@netlify/identity';

      const form = document.querySelector('#login-form');
      const status = document.querySelector('#status');
      const button = document.querySelector('#login-button');

      function showMessage(message) {
        if (status) status.textContent = message;
      }

      // Procesa invitaciones y otros enlaces enviados por Netlify Identity.
      handleAuthCallback()
        .then((result) => {
          if (result) {
            showMessage('Invitación procesada. Ahora puedes iniciar sesión.');
          }
        })
        .catch(() => {
          showMessage('No se pudo procesar el enlace. Solicita una nueva invitación.');
        });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const email = document.querySelector('#email')?.value.trim();
        const password = document.querySelector('#password')?.value;

        if (!email || !password) return;

        if (button) button.disabled = true;
        showMessage('Verificando acceso…');

        try {
          await login(email, password);
          window.location.href = '/admin';
        } catch {
          showMessage('No se pudo iniciar sesión. Revisa el correo y la contraseña.');
          if (button) button.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    background: #f3f5f8;
    color: #172033;
    font-family: Arial, sans-serif;
  }

  .login-card {
    width: min(100%, 420px);
    padding: 36px;
    border: 1px solid #e4e8ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 16px 45px rgb(20 35 60 / 10%);
  }

  .brand {
    color: #1769aa;
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
  }

  h1 {
    margin: 28px 0 8px;
  }

  .intro {
    margin: 0 0 24px;
    color: #657084;
    line-height: 1.5;
  }

  label {
    display: block;
    margin: 16px 0 7px;
    font-weight: 600;
  }

  input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccd3df;
    border-radius: 8px;
    font: inherit;
  }

  button {
    width: 100%;
    margin-top: 22px;
    padding: 13px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  #status {
    min-height: 1.5em;
    color: #4c5a70;
    line-height: 1.4;
  }
</style>