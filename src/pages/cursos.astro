---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getDatabase } from '@netlify/database';

type CourseRow = {
  title: string;
  slug: string;
  summary: string;
  cover_image_url: string | null;
  instructor_name: string;
  level: string | null;
  language: string;
  access_model: 'free' | 'paid' | 'external';
  price: string | number | null;
  currency: string;
};

const db = getDatabase();

const courses = (await db.sql<CourseRow>`
  SELECT
    title,
    slug,
    summary,
    cover_image_url,
    instructor_name,
    level,
    language,
    access_model,
    price,
    currency
  FROM courses
  WHERE status = 'published'
  ORDER BY published_at DESC NULLS LAST, created_at DESC
  LIMIT 24
`) as CourseRow[];

const modeloAcceso = (model: CourseRow['access_model']) => {
  if (model === 'free') return 'Gratis';
  if (model === 'paid') return 'De pago';
  return 'Curso externo';
};

const precioCurso = (course: CourseRow) => {
  if (course.access_model === 'free') return 'Gratis';
  if (course.access_model === 'external') return 'Acceso externo';
  if (course.price === null) return 'Precio próximamente';

  const price = Number(course.price);

  if (!Number.isFinite(price)) {
    return `${course.currency} ${course.price}`;
  }

  try {
    return new Intl.NumberFormat('es-EC', {
      style: 'currency',
      currency: course.currency.trim() || 'USD',
    }).format(price);
  } catch {
    return `${course.currency} ${price.toFixed(2)}`;
  }
};
---

<BaseLayout
  title="Cursos de tecnología | FelixPlace"
  description="Explora cursos de tecnología y aprendizaje práctico en FelixPlace."
>
  <main class="pagina">
    <header class="intro">
      <p class="etiqueta">APRENDE A TU RITMO</p>
      <h1>Cursos de tecnología</h1>
      <p>
        Explora cursos prácticos para desarrollar nuevas habilidades
        tecnológicas.
      </p>
    </header>

    {courses.length === 0 ? (
      <section class="vacio">
        <h2>Próximamente</h2>
        <p>
          Estamos preparando nuestros primeros cursos. Mientras tanto, puedes
          explorar las noticias y los tutoriales de FelixPlace.
        </p>
        <div class="enlaces">
          <a href="/noticias">Ver noticias</a>
          <a href="/tutoriales">Ver tutoriales</a>
        </div>
      </section>
    ) : (
      <section class="catalogo" aria-label="Catálogo de cursos">
        {courses.map((course) => (
          <article class="curso">
            <a
              class="portada"
              href={`/cursos/${course.slug}`}
              aria-label={`Ver detalles del curso ${course.title}`}
            >
              {course.cover_image_url ? (
                <img
                  src={course.cover_image_url}
                  alt={`Portada del curso ${course.title}`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="sin-portada" aria-hidden="true">FELIXPLACE</span>
              )}
            </a>

            <div class="contenido">
              <p class="tipo">{modeloAcceso(course.access_model)}</p>

              <h2>
                <a href={`/cursos/${course.slug}`}>{course.title}</a>
              </h2>

              <p class="resumen">{course.summary}</p>

              <dl>
                <div>
                  <dt>Instructor</dt>
                  <dd>{course.instructor_name}</dd>
                </div>

                {course.level && (
                  <div>
                    <dt>Nivel</dt>
                    <dd>{course.level}</dd>
                  </div>
                )}

                <div>
                  <dt>Idioma</dt>
                  <dd>{course.language}</dd>
                </div>

                <div>
                  <dt>Acceso</dt>
                  <dd>{precioCurso(course)}</dd>
                </div>
              </dl>

              <a class="boton" href={`/cursos/${course.slug}`}>
                Ver detalles del curso <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .pagina {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 48px 0 72px;
  }

  .intro {
    max-width: 720px;
    margin-bottom: 32px;
  }

  .etiqueta,
  .tipo {
    color: #1769aa;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 8px 0;
    color: #102247;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    line-height: 1.1;
  }

  .intro > p:last-child,
  .resumen,
  .vacio p {
    color: #596579;
    line-height: 1.7;
  }

  .catalogo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .curso {
    overflow: hidden;
    border: 1px solid #e1e7ef;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px rgb(23 32 51 / 7%);
  }

  .portada {
    display: block;
    aspect-ratio: 16 / 9;
    background: #eaf2f9;
  }

  .portada img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sin-portada {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: #1769aa;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .contenido {
    padding: 20px;
  }

  .tipo {
    display: inline-block;
    margin: 0 0 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #edf4fb;
    letter-spacing: 0.03em;
  }

  .curso h2 {
    margin: 0 0 8px;
    color: #102247;
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .curso h2 a {
    color: inherit;
    text-decoration: none;
  }

  .curso h2 a:hover {
    color: #1769aa;
  }

  .resumen {
    margin: 0 0 18px;
  }

  dl {
    display: grid;
    gap: 10px;
    margin: 18px 0;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  dt {
    color: #647084;
  }

  dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }

  .boton {
    display: inline-block;
    padding: 11px 16px;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .boton:hover {
    background: #12558b;
  }

  .vacio {
    padding: 28px;
    border: 1px solid #dce5ef;
    border-radius: 12px;
    background: #fff;
  }

  .vacio h2 {
    color: #102247;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 20px;
  }

  .enlaces a {
    color: #1769aa;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .pagina {
      width: min(100% - 32px, 1100px);
      padding-top: 32px;
    }
  }
</style>