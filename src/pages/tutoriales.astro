---
export const prerender = false;

import { getDatabase } from '@netlify/database';

const db = getDatabase();

const posts = await db.sql`
  SELECT title, slug, category, image_url, image_alt, description, author_name, published_at
  FROM posts
  WHERE status = 'published'
    AND kind = 'tutorial'
  ORDER BY published_at DESC NULLS LAST, created_at DESC
  LIMIT 12
`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Tutoriales de tecnología | FelixPlace</title>
    <meta
      name="description"
      content="Aprende tecnología con los tutoriales paso a paso de FelixPlace."
    />
  </head>

  <body>
    <main>
      <p class="marca">FELIXPLACE</p>
      <nav aria-label="Secciones">
        <a href="/noticias">Noticias</a>
        <a href="/tutoriales" aria-current="page">Tutoriales</a>
      </nav>

      <h1>Tutoriales de tecnología</h1>
      <p class="intro">Guías y explicaciones paso a paso.</p>

      {posts.length === 0 ? (
        <p class="aviso">Aún no hay tutoriales publicados. Pronto encontrarás contenido aquí.</p>
      ) : (
        <section class="grid" aria-label="Tutoriales recientes">
          {posts.map((post) => (
            <article class="card">
              {post.image_url && (
                <img
                  src={post.image_url}
                  alt={post.image_alt || post.title}
                  loading="lazy"
                  decoding="async"
                />
              )}

              <p class="categoria">{post.category || 'Tutorial'}</p>

              <h2>
                <a href={`/tutoriales/${post.slug}`}>{post.title}</a>
              </h2>

              <p>{post.description}</p>

              <small>
                Por {post.author_name}
                {post.published_at &&
                  ` · ${new Date(post.published_at).toLocaleDateString('es-EC')}`}
              </small>
            </article>
          ))}
        </section>
      )}
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    padding: 2rem;
    color: #172033;
    font-family: system-ui, sans-serif;
    background: #f4f6fa;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
  }

  .marca {
    color: #1769aa;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  nav {
    display: flex;
    gap: 18px;
    margin-bottom: 2rem;
  }

  nav a {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: #172033;
  }

  h1 {
    margin-bottom: 8px;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .intro {
    margin-bottom: 2rem;
    color: #647084;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    padding: 1rem;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px #17203312;
  }

  .card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
  }

  .categoria {
    color: #1769aa;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .card h2 {
    line-height: 1.3;
  }

  .card a {
    color: inherit;
    text-decoration: none;
  }

  .card a:hover {
    color: #1769aa;
  }

  .card small,
  .aviso {
    color: #647084;
  }
</style>