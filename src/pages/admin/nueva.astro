---
import { actions } from 'astro:actions';
import { getUser } from '@netlify/identity';

export const prerender = false;

const user = await getUser();

if (!user) {
  return Astro.redirect('/admin/login');
}

if (!user.roles?.some((role) => role === 'admin' || role === 'editor')) {
  return new Response('Tu cuenta no tiene permiso para crear publicaciones.', {
    status: 403,
  });
}

const actionResult = Astro.getActionResult(actions.createPost);

if (actionResult && !actionResult.error) {
  return Astro.redirect('/admin/nueva?guardado=1');
}

const errorMessage = actionResult?.error?.message;
const guardado = Astro.url.searchParams.get('guardado') === '1';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nueva publicación | FelixPlace</title>
  </head>

  <body>
    <main class="panel">
      <a class="volver" href="/admin">← Volver al panel</a>

      <p class="marca">FELIXPLACE</p>
      <h1>Nueva publicación</h1>
      <p class="ayuda">Las publicaciones se guardarán como borradores.</p>

      {guardado && (
        <p class="mensaje exito">Borrador guardado correctamente.</p>
      )}

      {errorMessage && <p class="mensaje error">{errorMessage}</p>}

      <form method="POST" action={actions.createPost}>
        <label for="kind">Tipo de publicación</label>
        <select id="kind" name="kind" required>
          <option value="news">Noticia</option>
          <option value="tutorial">Tutorial</option>
        </select>

        <label for="title">Título</label>
        <input
          id="title"
          name="title"
          type="text"
          minlength="5"
          maxlength="180"
          required
        />

        <label for="slug">Slug de la URL</label>
        <input
          id="slug"
          name="slug"
          type="text"
          pattern="[a-z0-9]+(-[a-z0-9]+)*"
          maxlength="180"
          required
        />
        <small>Se genera desde el título y puedes editarlo.</small>

        <label for="category">Categoría</label>
        <input id="category" name="category" type="text" maxlength="80" />

        <fieldset id="campos-imagen">
          <legend>Imagen de la noticia</legend>

          <label for="image_url">URL de la imagen de Postimages</label>
          <input
            id="image_url"
            name="image_url"
            type="url"
            maxlength="2048"
            placeholder="https://..."
          />

          <label for="image_alt">Texto alternativo de la imagen</label>
          <input id="image_alt" name="image_alt" type="text" maxlength="200" />
        </fieldset>

        <fieldset id="campos-video" hidden disabled>
          <legend>Video del tutorial</legend>

          <label for="video_url">Enlace del video de YouTube</label>
          <input
            id="video_url"
            name="video_url"
            type="url"
            maxlength="2048"
            placeholder="https://youtu.be/..."
          />

          <small>
            Pega el enlace normal del video. El sitio lo mostrará en un
            reproductor dentro del tutorial.
          </small>
        </fieldset>

        <label for="description">Descripción breve</label>
        <textarea
          id="description"
          name="description"
          rows="3"
          maxlength="350"
        ></textarea>

        <label for="body_markdown">Contenido o explicación</label>
        <textarea
          id="body_markdown"
          name="body_markdown"
          rows="14"
          maxlength="50000"
          placeholder="Puedes añadir contexto, pasos o información complementaria."
        ></textarea>

        <label for="seo_title">Título SEO (opcional)</label>
        <input id="seo_title" name="seo_title" type="text" maxlength="180" />

        <label for="seo_description">Descripción SEO (opcional)</label>
        <textarea
          id="seo_description"
          name="seo_description"
          rows="3"
          maxlength="200"
        ></textarea>

        <button type="submit">Guardar borrador</button>
      </form>
    </main>

    <script>
      const kindInput = document.querySelector<HTMLSelectElement>('#kind');
      const imageFields = document.querySelector<HTMLFieldSetElement>(
        '#campos-imagen',
      );
      const videoFields = document.querySelector<HTMLFieldSetElement>(
        '#campos-video',
      );
      const videoInput =
        document.querySelector<HTMLInputElement>('#video_url');
      const titleInput = document.querySelector<HTMLInputElement>('#title');
      const slugInput = document.querySelector<HTMLInputElement>('#slug');

      let slugEditado = false;

      function actualizarCamposTipo() {
        const esTutorial = kindInput?.value === 'tutorial';

        if (imageFields) {
          imageFields.hidden = Boolean(esTutorial);
          imageFields.disabled = Boolean(esTutorial);
        }

        if (videoFields) {
          videoFields.hidden = !esTutorial;
          videoFields.disabled = !esTutorial;
        }

        if (videoInput) {
          videoInput.required = Boolean(esTutorial);
        }
      }

      function crearSlug(texto: string) {
        return texto
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');
      }

      kindInput?.addEventListener('change', actualizarCamposTipo);
      actualizarCamposTipo();

      titleInput?.addEventListener('input', () => {
        if (titleInput && slugInput && !slugEditado) {
          slugInput.value = crearSlug(titleInput.value);
        }
      });

      slugInput?.addEventListener('input', () => {
        if (slugInput) {
          slugEditado = true;
          slugInput.value = crearSlug(slugInput.value);
        }
      });
    </script>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    padding: 24px;
    background: #f3f5f8;
    color: #172033;
    font-family: Arial, sans-serif;
  }

  .panel {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 32px;
    border: 1px solid #e4e8ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 16px 45px rgb(20 35 60 / 8%);
  }

  .volver {
    color: #1769aa;
    text-decoration: none;
  }

  .marca {
    margin-top: 28px;
    color: #1769aa;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .ayuda,
  small {
    color: #596579;
    line-height: 1.5;
  }

  form {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  label,
  legend {
    margin-top: 10px;
    font-weight: 700;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd3df;
    border-radius: 8px;
    color: inherit;
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  fieldset {
    display: grid;
    gap: 10px;
    margin: 12px 0 0;
    padding: 16px;
    border: 1px solid #d9e1ec;
    border-radius: 10px;
  }

  fieldset[hidden] {
    display: none;
  }

  legend {
    padding: 0 6px;
    color: #102247;
  }

  button {
    margin-top: 18px;
    padding: 14px 18px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:hover {
    background: #12588f;
  }

  .mensaje {
    padding: 12px;
    border-radius: 8px;
  }

  .exito {
    background: #e9f8ef;
    color: #176236;
  }

  .error {
    background: #fff0f0;
    color: #9b2020;
  }

  @media (max-width: 600px) {
    body {
      padding: 16px;
    }

    .panel {
      padding: 22px;
    }
  }
</style>