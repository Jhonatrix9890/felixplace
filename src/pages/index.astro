---
export const prerender = false;

import { getDatabase } from '@netlify/database';
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.headers.set(
  'Netlify-CDN-Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=300',
);

const db = getDatabase();

const posts = await db.sql`
  SELECT kind, title, slug, category, image_url, image_alt, description
  FROM posts
  WHERE status = 'published'
  ORDER BY published_at DESC NULLS LAST, created_at DESC
  LIMIT 6
`;

const organizacionJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FelixPlace',
  url: 'https://felixplace.com/',
  logo: 'https://felixplace.com/assets/logo.png',
  sameAs: [
    'https://www.facebook.com/felixplace13',
    'https://www.youtube.com/@felixplace2947',
    'https://www.tiktok.com/@felixplace13',
  ],
  description:
    'Noticias y tutoriales de tecnología explicados de forma clara.',
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title="FelixPlace | Tecnología para todos"
  description="Noticias, tutoriales y cursos de tecnología explicados con claridad."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={organizacionJsonLd}
  ></script>

  <main>
    <section class="portada">
      <p class="etiqueta">TECNOLOGÍA PARA TODOS</p>
      <h1>Aprende, descubre y mantente al día.</h1>
      <p class="intro">
        Noticias y tutoriales explicados de forma clara para ayudarte a
        aprovechar mejor la tecnología.
      </p>

      <div class="enlaces">
        <a class="boton" href="/noticias">Leer noticias</a>
        <a class="boton secundario" href="/tutoriales">Ver tutoriales</a>
      </div>
    </section>

    <section class="recientes">
      <div class="titulo-seccion">
        <div>
          <p class="etiqueta">NUEVO EN FELIXPLACE</p>
          <h2>Publicaciones recientes</h2>
        </div>
        <a class="ver-todo" href="/noticias">Ver publicaciones →</a>
      </div>

      {posts.length === 0 ? (
        <p class="vacio">
          Pronto encontrarás aquí nuestras primeras publicaciones.
        </p>
      ) : (
        <div class="grid">
          {posts.map((post) => {
            const esTutorial = post.kind === 'tutorial';
            const ruta = esTutorial
              ? `/tutoriales/${post.slug}`
              : `/noticias/${post.slug}`;

            return (
              <article class="tarjeta">
                {esTutorial ? (
                  <div class="video-etiqueta" aria-label="Tutorial en video">
                    <span aria-hidden="true">▶</span>
                    <span>Tutorial en video</span>
                  </div>
                ) : post.image_url ? (
                  <img
                    class="imagen"
                    src={post.image_url}
                    alt={post.image_alt || post.title}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="imagen-vacia" aria-hidden="true">FELIXPLACE</div>
                )}

                <p class="categoria">
                  {post.category || (esTutorial ? 'Tutorial' : 'Noticia')}
                </p>

                <h3><a href={ruta}>{post.title}</a></h3>

                {post.description && (
                  <p class="descripcion">{post.description}</p>
                )}

                <a class="enlace" href={ruta}>
                  {esTutorial ? 'Ver tutorial' : 'Leer noticia'} →
                </a>
              </article>
            );
          })}
        </div>
      )}
    </section>

    <section class="explorar">
      <h2>Explora FelixPlace</h2>
      <div class="explorar-enlaces">
        <a href="/noticias">
          Todas las noticias <span aria-hidden="true">→</span>
        </a>
        <a href="/tutoriales">
          Todos los tutoriales <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    width: min(100% - 40px, 1100px);
    margin: 0 auto;
  }

  .portada {
    padding: clamp(56px, 10vw, 105px) 0 76px;
  }

  .etiqueta,
  .categoria {
    color: #1769aa;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .portada h1 {
    max-width: 780px;
    margin: 12px 0;
    color: #172033;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  .intro {
    max-width: 650px;
    color: #596579;
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .boton {
    display: inline-block;
    padding: 12px 18px;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .boton.secundario {
    background: #e8f0f8;
    color: #1769aa;
  }

  .recientes {
    padding-bottom: 64px;
  }

  .titulo-seccion {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .titulo-seccion .etiqueta {
    margin: 0 0 6px;
  }

  .titulo-seccion h2,
  .explorar h2 {
    margin: 0;
    color: #172033;
    font-size: clamp(1.6rem, 4vw, 2rem);
  }

  .ver-todo,
  .enlace {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  .ver-todo:hover,
  .enlace:hover {
    text-decoration: underline;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  .tarjeta {
    display: flex;
    min-height: 320px;
    flex-direction: column;
    align-items: flex-start;
    padding: 16px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 18px rgb(23 32 51 / 5%);
  }

  .imagen,
  .imagen-vacia,
  .video-etiqueta {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
  }

  .imagen {
    object-fit: cover;
  }

  .imagen-vacia,
  .video-etiqueta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #edf2f7;
    color: #526176;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .video-etiqueta {
    background: #eaf2f9;
    color: #1769aa;
  }

  .video-etiqueta span:first-child {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    background: #1769aa;
    color: #fff;
  }

  .categoria {
    margin: 18px 0 6px;
    font-size: 0.75rem;
  }

  .tarjeta h3 {
    margin: 0 0 8px;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .tarjeta h3 a {
    color: #172033;
    text-decoration: none;
  }

  .tarjeta h3 a:hover {
    color: #1769aa;
  }

  .descripcion,
  .vacio {
    color: #647084;
    line-height: 1.6;
  }

  .enlace {
    margin-top: auto;
    padding-top: 8px;
  }

  .explorar {
    margin-bottom: 64px;
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #fff;
  }

  .explorar-enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 18px;
  }

  .explorar-enlaces a {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    main {
      width: min(100% - 32px, 1100px);
    }

    .titulo-seccion {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>