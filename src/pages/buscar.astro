---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDatabase } from '@netlify/database';

export const prerender = false;

type SearchPost = {
  kind: 'news' | 'tutorial';
  title: string;
  slug: string;
  category: string | null;
  image_url: string | null;
  image_alt: string | null;
  description: string;
};

const termino = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);

let posts: SearchPost[] = [];

if (termino) {
  const db = getDatabase();
  const coincidencia = `%${termino}%`;

  posts = (await db.sql<SearchPost>`
    SELECT
      kind,
      title,
      slug,
      category,
      image_url,
      image_alt,
      description
    FROM posts
    WHERE status = 'published'
      AND (
        title ILIKE ${coincidencia}
        OR category ILIKE ${coincidencia}
        OR description ILIKE ${coincidencia}
      )
    ORDER BY published_at DESC NULLS LAST, created_at DESC
    LIMIT 30
  `) as SearchPost[];
}
---

<BaseLayout
  title="Buscar | FelixPlace"
  description="Busca noticias y tutoriales publicados en FelixPlace."
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <main class="pagina">
    <p class="etiqueta">EXPLORA FELIXPLACE</p>
    <h1>Buscar noticias y tutoriales</h1>

    <form action="/buscar" method="GET" class="buscador">
      <label for="q">¿Qué tema estás buscando?</label>
      <div class="fila">
        <input
          id="q"
          name="q"
          type="search"
          maxlength="100"
          value={termino}
          placeholder="Por ejemplo: Windows, seguridad, celulares..."
        />
        <button type="submit">Buscar</button>
      </div>
    </form>

    {termino ? (
      <>
        <h2>Resultados para “{termino}”</h2>

        {posts.length === 0 ? (
          <p class="aviso">
            No encontramos publicaciones con ese término. Prueba con otras
            palabras.
          </p>
        ) : (
          <section class="resultados" aria-label="Resultados de búsqueda">
            {posts.map((post) => {
              const ruta =
                post.kind === 'tutorial'
                  ? `/tutoriales/${post.slug}`
                  : `/noticias/${post.slug}`;

              return (
                <article class="resultado">
                  {post.kind === 'news' && post.image_url && (
                    <img
                      src={post.image_url}
                      alt={post.image_alt || post.title}
                      loading="lazy"
                    />
                  )}

                  <div>
                    <p class="tipo">
                      {post.category ||
                        (post.kind === 'tutorial' ? 'Tutorial' : 'Noticia')}
                    </p>
                    <h3><a href={ruta}>{post.title}</a></h3>
                    <p class="descripcion">{post.description}</p>
                    <a class="leer" href={ruta}>Leer publicación →</a>
                  </div>
                </article>
              );
            })}
          </section>
        )}
      </>
    ) : (
      <p class="aviso">
        Escribe una palabra o tema para buscar entre las publicaciones.
      </p>
    )}
  </main>
</BaseLayout>

<style>
  .pagina {
    width: min(1000px, calc(100% - 40px));
    margin: 0 auto;
    padding: 52px 0 24px;
  }

  .etiqueta,
  .tipo {
    color: #1769aa;
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 10px 0 28px;
    color: #102247;
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.1;
  }

  h2 {
    margin-top: 36px;
    color: #102247;
  }

  .buscador {
    padding: 22px;
    border: 1px solid #dce5ef;
    border-radius: 12px;
    background: #fff;
  }

  .buscador label {
    display: block;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .fila {
    display: flex;
    gap: 10px;
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 12px;
    border: 1px solid #cbd3df;
    border-radius: 8px;
    font: inherit;
  }

  button {
    padding: 12px 18px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .resultados {
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }

  .resultado {
    display: grid;
    grid-template-columns: minmax(150px, 240px) 1fr;
    gap: 20px;
    padding: 18px;
    border: 1px solid #e1e7ef;
    border-radius: 12px;
    background: #fff;
  }

  .resultado img {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    object-fit: cover;
  }

  .resultado h3 {
    margin: 8px 0;
    font-size: 1.2rem;
  }

  .resultado h3 a {
    color: #102247;
    text-decoration: none;
  }

  .resultado h3 a:hover,
  .leer:hover {
    color: #1769aa;
  }

  .tipo {
    margin: 0;
    letter-spacing: 0.04em;
  }

  .descripcion,
  .aviso {
    color: #596579;
    line-height: 1.6;
  }

  .leer {
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  .aviso {
    margin-top: 24px;
    padding: 16px;
    border-radius: 8px;
    background: #edf4fb;
  }

  @media (max-width: 600px) {
    .fila {
      flex-direction: column;
    }

    .resultado {
      grid-template-columns: 1fr;
    }
  }
</style>