---
import { getUser } from '@netlify/identity';
import { getDatabase } from '@netlify/database';

export const prerender = false;

const user = await getUser();

if (!user) {
  return Astro.redirect('/admin/login');
}

if (!(user.roles ?? []).includes('admin')) {
  return new Response('Tu cuenta todavía no tiene el rol de administrador.', {
    status: 403,
  });
}

type PostRow = {
  id: string;
  kind: 'news' | 'tutorial';
  title: string;
  slug: string;
  status: string;
};

let posts: PostRow[] = [];
let errorMessage = '';

try {
  const db = getDatabase();

  posts = (await db.sql`
    SELECT id, kind, title, slug, status
    FROM posts
    ORDER BY updated_at DESC
    LIMIT 50
  `) as unknown as PostRow[];
} catch (error) {
  errorMessage =
    error instanceof Error
      ? error.message
      : 'No se pudieron cargar las publicaciones.';
}

const tipoPublicacion = (kind: PostRow['kind']) =>
  kind === 'news' ? 'Noticia' : 'Tutorial';

const estadoPublicacion = (status: string) => {
  const estados: Record<string, string> = {
    draft: 'Borrador',
    review: 'En revisión',
    scheduled: 'Programada',
    published: 'Publicada',
    archived: 'Archivada',
  };

  return estados[status] ?? status;
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administración | FelixPlace</title>
  </head>

  <body>
    <main class="panel">
      <header class="encabezado">
        <div>
          <p class="marca">FELIXPLACE</p>
          <h1>Panel de administración</h1>
          <p class="sesion">
            Sesión iniciada como <strong>{user.email}</strong>
          </p>
        </div>

        <button id="logout-button" class="secundario" type="button">
          Cerrar sesión
        </button>
      </header>

      <section class="publicaciones">
        <div class="titulo-seccion">
          <div>
            <h2>Publicaciones</h2>
            <p>Noticias y tutoriales guardados en la base de datos.</p>
          </div>

          <a class="accion" href="/admin/nueva">Nueva publicación</a>
        </div>

        {errorMessage ? (
          <p class="aviso error">
            No se pudieron cargar las publicaciones: {errorMessage}
          </p>
        ) : posts.length === 0 ? (
          <p class="aviso">
            Todavía no hay publicaciones. Puedes crear la primera como borrador.
          </p>
        ) : (
          <div class="lista">
            {posts.map((post) => (
              <article class="publicacion">
                <div>
                  <span class="tipo">{tipoPublicacion(post.kind)}</span>
                  <h3>{post.title}</h3>
                  <p class="slug">/{post.slug}</p>
                </div>

                <span class="estado">{estadoPublicacion(post.status)}</span>
              </article>
            ))}
          </div>
        )}
      </section>
    </main>

    <script>
      import { logout } from '@netlify/identity';

      document
        .querySelector('#logout-button')
        ?.addEventListener('click', async () => {
          await logout();
          window.location.href = '/admin/login';
        });
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    margin: 0;
    padding: 32px 20px;
    background: #f3f5f8;
    color: #172033;
    font-family: Arial, sans-serif;
  }

  .panel {
    width: min(100%, 960px);
    margin: 0 auto;
    padding: 32px;
    border: 1px solid #e4e8ef;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 16px 45px rgb(20 35 60 / 8%);
  }

  .encabezado,
  .titulo-seccion,
  .publicacion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .encabezado {
    padding-bottom: 24px;
    border-bottom: 1px solid #e4e8ef;
  }

  .marca {
    margin: 0 0 8px;
    color: #1769aa;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 8px;
  }

  .sesion,
  .titulo-seccion p,
  .slug {
    color: #647084;
  }

  .sesion {
    margin-bottom: 0;
  }

  .publicaciones {
    padding-top: 24px;
  }

  .titulo-seccion {
    margin-bottom: 20px;
  }

  .titulo-seccion h2 {
    margin-bottom: 6px;
  }

  .titulo-seccion p {
    margin-bottom: 0;
  }

  .accion,
  .secundario {
    display: inline-block;
    padding: 12px 16px;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .secundario {
    background: #edf2f7;
    color: #172033;
  }

  .lista {
    display: grid;
    gap: 12px;
  }

  .publicacion {
    padding: 18px;
    border: 1px solid #e4e8ef;
    border-radius: 10px;
  }

  .publicacion h3 {
    margin: 8px 0 4px;
  }

  .tipo,
  .estado {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 999px;
    background: #edf4fb;
    color: #1769aa;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .estado {
    background: #f1f3f6;
    color: #465166;
    white-space: nowrap;
  }

  .slug {
    margin-bottom: 0;
    overflow-wrap: anywhere;
  }

  .aviso {
    padding: 16px;
    border-radius: 8px;
    background: #f3f6fa;
  }

  .error {
    background: #fff1f0;
    color: #9b2525;
  }

  @media (max-width: 640px) {
    .panel {
      padding: 22px 18px;
    }

    .encabezado,
    .titulo-seccion {
      align-items: flex-start;
      flex-direction: column;
    }

    .publicacion {
      align-items: flex-start;
    }
  }
</style>