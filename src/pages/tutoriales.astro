---
export const prerender = false;

import { getDatabase } from '@netlify/database';
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.headers.set(
  'Netlify-CDN-Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=300',
);

const db = getDatabase();

const tutorials = await db.sql`
  SELECT slug, title, category, description
  FROM posts
  WHERE kind = 'tutorial'
    AND status = 'published'
  ORDER BY published_at DESC NULLS LAST, created_at DESC
  LIMIT 12
`;
---

<BaseLayout
  title="Tutoriales de tecnología | FelixPlace"
  description="Guías y tutoriales en video para aprender tecnología paso a paso."
>
  <main class="pagina">
    <header class="encabezado">
      <p class="etiqueta">APRENDE PASO A PASO</p>
      <h1>Tutoriales</h1>
      <p>
        Videos y guías prácticas para aprovechar mejor la tecnología.
      </p>
    </header>

    {tutorials.length === 0 ? (
      <p class="vacio">Pronto publicaremos nuestros primeros tutoriales.</p>
    ) : (
      <section class="grid" aria-label="Tutoriales publicados">
        {tutorials.map((tutorial) => (
          <article class="tarjeta">
            <p class="tipo">▶ Tutorial en video</p>

            <p class="categoria">{tutorial.category || 'Tecnología'}</p>

            <h2>
              <a href={`/tutoriales/${tutorial.slug}`}>{tutorial.title}</a>
            </h2>

            {tutorial.description && <p class="descripcion">{tutorial.description}</p>}

            <a class="enlace" href={`/tutoriales/${tutorial.slug}`}>
              Ver tutorial <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .pagina {
    width: min(100% - 40px, 1100px);
    margin: 0 auto;
    padding: 48px 0 72px;
  }

  .encabezado {
    max-width: 720px;
    margin-bottom: 32px;
  }

  .etiqueta,
  .categoria {
    color: #1769aa;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 8px 0;
    color: #172033;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    line-height: 1.1;
  }

  .encabezado > p:last-child,
  .descripcion,
  .vacio {
    color: #596579;
    line-height: 1.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .tarjeta {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    align-items: flex-start;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 5px 20px rgb(23 32 51 / 5%);
  }

  .tipo {
    margin: 0 0 22px;
    padding: 7px 10px;
    border-radius: 999px;
    background: #edf4fb;
    color: #1769aa;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .categoria {
    margin: 0 0 8px;
    font-size: 0.75rem;
  }

  .tarjeta h2 {
    margin: 0 0 10px;
    font-size: 1.3rem;
    line-height: 1.35;
  }

  .tarjeta h2 a {
    color: #172033;
    text-decoration: none;
  }

  .tarjeta h2 a:hover {
    color: #1769aa;
  }

  .descripcion {
    margin: 0 0 20px;
  }

  .enlace {
    margin-top: auto;
    color: #1769aa;
    font-weight: 700;
    text-decoration: none;
  }

  .enlace:hover {
    text-decoration: underline;
  }

  .vacio {
    padding: 24px;
    border-radius: 12px;
    background: #fff;
  }

  @media (max-width: 600px) {
    .pagina {
      width: min(100% - 32px, 1100px);
      padding-top: 32px;
    }
  }
</style>