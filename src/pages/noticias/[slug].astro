---
export const prerender = false;

import { getDatabase } from '@netlify/database';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

const slug = Astro.params.slug;
const db = getDatabase();

const [post] = await db.sql`
  SELECT
    kind,
    title,
    slug,
    category,
    image_url,
    image_alt,
    description,
    body_markdown,
    author_name,
    published_at,
    seo_title,
    seo_description
  FROM posts
  WHERE slug = ${slug}
    AND status = 'published'
  LIMIT 1
`;

if (!post) {
  Astro.response.status = 404;
}

const pageTitle = post?.seo_title || post?.title || 'Publicación no encontrada';
const pageDescription =
  post?.seo_description ||
  post?.description ||
  'Noticias y tutoriales de FelixPlace.';

const articleHtml = post
  ? sanitizeHtml(await marked.parse(post.body_markdown || ''))
  : '';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle} | FelixPlace</title>
    <meta name="description" content={pageDescription} />
  </head>

  <body>
    <main>
      {post ? (
        <article>
          <a href="/noticias">← Volver a noticias</a>

          <p>{post.category} · {post.kind}</p>
          <h1>{post.title}</h1>
          <p>{post.description}</p>
          <p>Por {post.author_name}</p>

          {post.image_url && (
            <img src={post.image_url} alt={post.image_alt || post.title} />
          )}

          <div class="contenido" set:html={articleHtml}></div>
        </article>
      ) : (
        <section>
          <h1>Publicación no encontrada</h1>
          <p>Esta noticia no existe o todavía no está publicada.</p>
          <a href="/noticias">Volver a noticias</a>
        </section>
      )}
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 2rem;
    color: #172033;
    font-family: system-ui, sans-serif;
    background: #f4f6fa;
  }

  main {
    max-width: 820px;
    margin: 0 auto;
  }

  article,
  section {
    padding: 2rem;
    border-radius: 12px;
    background: white;
  }

  img {
    display: block;
    width: 100%;
    max-height: 480px;
    margin: 1.5rem 0;
    border-radius: 10px;
    object-fit: cover;
  }

  .contenido {
    line-height: 1.8;
  }
</style>