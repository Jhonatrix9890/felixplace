---
export const prerender = false;

import { getDatabase } from '@netlify/database';
import { actions } from 'astro:actions';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

const slug = Astro.params.slug;
const db = getDatabase();

const [post] = await db.sql`
  SELECT
    id,
    title,
    slug,
    category,
    image_url,
    image_alt,
    description,
    body_markdown,
    author_name,
    published_at,
    seo_title,
    seo_description
  FROM posts
  WHERE slug = ${slug}
    AND kind = 'tutorial'
    AND status = 'published'
  LIMIT 1
`;

if (!post) {
  Astro.response.status = 404;
}

const comments = post
  ? await db.sql`
      SELECT display_name, body, created_at
      FROM comments
      WHERE post_id = ${post.id}
        AND status = 'approved'
      ORDER BY created_at ASC
      LIMIT 50
    `
  : [];

const commentResult = Astro.getActionResult(actions.submitComment);
const commentError = commentResult?.error?.message;
const commentSent = Boolean(commentResult?.data);

const pageTitle = post?.seo_title || post?.title || 'Tutorial no encontrado';
const pageDescription =
  post?.seo_description ||
  post?.description ||
  'Tutoriales de tecnología en FelixPlace.';

const articleHtml = post
  ? sanitizeHtml(await marked.parse(post.body_markdown || ''))
  : '';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle} | FelixPlace</title>
    <meta name="description" content={pageDescription} />
  </head>

  <body>
    <main>
      {post ? (
        <article>
          <a href="/tutoriales">← Volver a tutoriales</a>

          <p>{post.category} · Tutorial</p>
          <h1>{post.title}</h1>
          <p>{post.description}</p>
          <p>Por {post.author_name}</p>

          {post.image_url && (
            <img src={post.image_url} alt={post.image_alt || post.title} />
          )}

          <div class="contenido" set:html={articleHtml}></div>
        </article>
      ) : (
        <section>
          <h1>Tutorial no encontrado</h1>
          <p>Este tutorial no existe o todavía no está publicado.</p>
          <a href="/tutoriales">Volver a tutoriales</a>
        </section>
      )}

      {post && (
        <section class="comentarios">
          <h2>Comentarios</h2>

          {commentSent && (
            <p class="aviso">
              Gracias por comentar. Tu comentario quedó pendiente de revisión.
            </p>
          )}

          {commentError && (
            <p class="aviso error">{commentError}</p>
          )}

          {comments.length === 0 ? (
            <p>Aún no hay comentarios aprobados.</p>
          ) : (
            <div class="lista-comentarios">
              {comments.map((comment) => (
                <article class="comentario">
                  <h3>{comment.display_name}</h3>
                  <p>{comment.body}</p>
                </article>
              ))}
            </div>
          )}

          <h3>Escribe un comentario</h3>

          <form method="POST" action={actions.submitComment}>
            <input type="hidden" name="post_id" value={post.id} />

            <label for="display_name">Tu nombre</label>
            <input
              id="display_name"
              name="display_name"
              type="text"
              minlength="2"
              maxlength="80"
              required
            />

            <label for="body">Comentario</label>
            <textarea
              id="body"
              name="body"
              minlength="2"
              maxlength="2000"
              rows="5"
              required
            ></textarea>

            <div class="campo-oculto" aria-hidden="true">
              <label for="website">No llenes este campo</label>
              <input
                id="website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <button type="submit">Enviar comentario</button>
          </form>
        </section>
      )}
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 2rem;
    color: #172033;
    font-family: system-ui, sans-serif;
    background: #f4f6fa;
  }

  main {
    max-width: 820px;
    margin: 0 auto;
  }

  article,
  section {
    padding: 2rem;
    border-radius: 12px;
    background: white;
  }

  .contenido,
  .comentarios {
    line-height: 1.8;
  }

  img {
    display: block;
    width: 100%;
    max-height: 480px;
    margin: 1.5rem 0;
    border-radius: 10px;
    object-fit: cover;
  }

  .comentarios {
    margin-top: 1.5rem;
  }

  .lista-comentarios {
    display: grid;
    gap: 1rem;
  }

  .comentario {
    padding: 1rem;
    border: 1px solid #e4e8ef;
  }

  .comentario h3 {
    margin-top: 0;
  }

  form {
    display: grid;
    gap: 0.75rem;
  }

  input,
  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem;
    border: 1px solid #cbd3df;
    border-radius: 8px;
    font: inherit;
  }

  button {
    width: fit-content;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 8px;
    background: #1769aa;
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .aviso {
    padding: 1rem;
    border-radius: 8px;
    background: #edf4fb;
  }

  .error {
    background: #fff1f0;
    color: #9b2525;
  }

  .campo-oculto {
    position: absolute;
    left: -10000px;
  }
</style>